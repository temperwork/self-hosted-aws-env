# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

name   = "acme"
region = "us-west-2"

# From temperwork: Settings → Environments → Add environment.
temperwork_role_arn = "arn:aws:iam::<temperwork account>:role/<role>"
external_id     = "<the random external id the form suggests>"

# Browsers outside AWS need the VPN to open your files (billed by the hour).
vpn = false

# Zones that offer your GPU instance type (not every zone has every type).
# zone_names = ["us-west-2b", "us-west-2c"]

# Your workers: one entry per model and kind of work, each with its own
# queue. instances > 0 runs them on always-on EC2 instances (billed while
# they run); 0 means you run them your own way. Store the enrollment token
# in SSM first: see docs/workers.md.
# workers = {
#   edit    = { model = "qwen-image-edit-2511", work = "inference", image = "ghcr.io/temperwork/qwen-image-edit-2511:customer-prod-latest", instances = 1 }
#   trainer = { model = "qwen-image-edit-2511", work = "training", image = "ghcr.io/temperwork/qwen-image-edit-2511-trainer:customer-prod-latest" }
# }
# judge_worker = {
#   image     = "ghcr.io/temperwork/judge-worker:customer-prod-latest"
#   instances = 1
#   models    = { vl = { model = "qwen3-vl-8b", image = "ghcr.io/temperwork/qwen-vl:customer-prod-latest" } }
# }
# enroll_token_parameter = "/temperwork/enroll-token"

tags = {
  project = "temperwork"
}
