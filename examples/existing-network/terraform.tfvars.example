# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

name   = "acme"
region = "us-west-2"

# From temperwork: Settings → Environments → Add environment.
temperwork_role_arn = "arn:aws:iam::<temperwork account>:role/<role>"
external_id     = "<the random external id the form suggests>"

# Your S3 VPC endpoint(s): the only way temperwork's links to your data work,
# so your people open files on your VPN or inside the VPC.
vpc_endpoint_ids = ["vpce-0123456789abcdef0"]

# Use a bucket you already have. Its bucket policy is replaced, so pass the
# current one to keep its statements:
#   aws s3api get-bucket-policy --bucket acme-ml-data --query Policy --output text > existing-policy.json
# bucket                      = "acme-ml-data"
# existing_bucket_policy_file = "existing-policy.json"

# temperwork's records go in a separate bucket, <name>-control by default.
# To use one you already have (empty, and not your data's bucket):
# control_bucket = "acme-temperwork-control"

# Your workers: one entry per model and kind of work, each with its own
# queue. instances > 0 runs them on always-on EC2 instances (billed while
# they run); 0 means you run them your own way. Store the enrollment token
# in SSM first: see docs/workers.md.
# workers = {
#   edit    = { model = "qwen-image-edit-2511", image = "<registry>/qwen-image:customer-prod-latest", instances = 1 }
#   trainer = { model = "qwen-image-edit-2511", work = "training", image = "<registry>/lora-trainer:customer-prod-latest" }
# }
# judge_worker           = { image = "<registry>/judge-worker:customer-prod-latest", instances = 1 }
# enroll_token_parameter = "/temperwork/enroll-token"
# ec2_subnet_ids         = ["subnet-0123456789abcdef0"]

tags = {
  project = "temperwork"
}
